KIND=tool
AXIS=tools
DESC="Set up git + your name and email"
LABEL="git"
CHECK_MAC='command -v git >/dev/null 2>&1'
INSTALL_MAC='brew install git'
SATISFIED_MAC='command -v git >/dev/null 2>&1 && git config --global --get user.name >/dev/null 2>&1'
CHECK_WIN='Get-Command git -ErrorAction SilentlyContinue'
INSTALL_WIN='winget install --id "Git.Git" -e --accept-package-agreements --accept-source-agreements'
SATISFIED_WIN='(Get-Command git -ErrorAction SilentlyContinue) -and (git config --global --get user.name 2>$null)'
