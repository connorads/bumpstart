KIND=tool
AXIS=tools
DESC="Install Node.js (LTS, via mise)"
INCLUDE="mise"
LABEL="Node.js"
CHECK_MAC='command -v node >/dev/null 2>&1 || mise which node >/dev/null 2>&1'
INSTALL_MAC='cd "$HOME" && mise use -g node@lts'
CHECK_WIN='Get-Command node -ErrorAction SilentlyContinue'
INSTALL_WIN='winget install --id "OpenJS.NodeJS.LTS" -e --accept-package-agreements --accept-source-agreements'
