KIND=auth
DESC="Set up GitHub CLI (gh) + sign in"
LABEL="gh"
CHECK_MAC='command -v gh >/dev/null 2>&1'
INSTALL_MAC='brew install gh'
SATISFIED_MAC='command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1'
CHECK_WIN='Get-Command gh -ErrorAction SilentlyContinue'
INSTALL_WIN='winget install --id "GitHub.cli" -e --accept-package-agreements --accept-source-agreements'
SATISFIED_WIN='(Get-Command gh -ErrorAction SilentlyContinue) -and (& { gh auth status 2>$null; $LASTEXITCODE -eq 0 })'
