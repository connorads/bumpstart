#!/usr/bin/env bash
set -euo pipefail
#
# bumpstart: fetch the bumpstart repo at BUMP_REF and hand the id list to the applier.
#
#   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/connorads/bumpstart/main/bumpstart)" _ claude react node
#   BUMP_REF=<sha> /bin/bash -c "$(curl -fsSL .../main/bumpstart)" _ claude starter   # pinned workshop
#
# The `bash -c "SCRIPT" _ a b` form sets $@ = a b. exec keeps stdin on the tty
# for the interactive prompts; the curl|tar pipe below uses its own stdin.

BUMP_REF="${BUMP_REF:-main}"
REPO="connorads/bumpstart"

# This paste serves macOS and Linux — send a native-Windows reader to the PowerShell
# paste that does work, before fetching anything. Exit 0: an honest redirect, not a
# failure (the applier repeats this guard after extraction).
#
# Deliberately duplicated, NOT routed through bump_os(): this guard runs before
# the tarball fetch below, so lib/os.sh does not exist yet — the whole point is to
# refuse without downloading anything. The cost is that the two guards must be
# changed together or a supported OS is still refused at the paste; tests/bumpstart.bats
# holds them to the same verdict for the same machine.
#
# WSL 1 first, for the same reason apply.sh checks it first: it passes for a
# supported Linux everywhere else, yet cannot exec the agent binaries at all
# (anthropics/claude-code#38788). Same lowercase-then-match logic as bump_wsl in
# lib/os.sh, and the same $BUMP_OSRELEASE_FILE test seam.
osrel_file="${BUMP_OSRELEASE_FILE:-/proc/sys/kernel/osrelease}"
osrel=""
[ -r "$osrel_file" ] && osrel="$(tr '[:upper:]' '[:lower:]' < "$osrel_file" 2>/dev/null || true)"
case "$osrel" in
  *wsl2*|*microsoft-standard*) : ;;   # WSL 2 is a supported Linux
  *microsoft*)
    printf 'This is WSL 1, where the coding agents cannot run.\n'
    printf 'In PowerShell on Windows, run:  wsl --set-version %s 2\n' "${WSL_DISTRO_NAME:-<your-distro>}"
    printf 'Then open this terminal again and paste the same line.\n'
    exit 0 ;;
esac

case "$(uname -s)" in
  Darwin|Linux) : ;;
  *)
    printf 'This paste runs on macOS and Linux.\n'
    printf 'On Windows, open PowerShell and paste this instead:\n'
    printf '  irm https://raw.githubusercontent.com/%s/main/bumpstart.ps1 | iex\n' "$REPO"
    exit 0 ;;
esac

tmp="$(mktemp -d "${TMPDIR:-/tmp}/bumpstart.XXXXXX")"

# The same curl-else-wget fallback as lib/common.sh's bump_fetch, spelled inline:
# this runs BEFORE the tarball that contains lib/common.sh exists. Ubuntu Desktop
# ships wget but not curl, so a curl-only bootstrap dies on the machine the Linux
# lane most needs to work.
fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- "$1"
  else
    printf 'bumpstart: need curl or wget to download anything — install one and re-run.\n' >&2
    return 1
  fi
}

if ! fetch "https://codeload.github.com/$REPO/tar.gz/$BUMP_REF" | tar -xz -C "$tmp"; then
  printf 'bumpstart: could not fetch %s@%s — check the ref and your connection.\n' "$REPO" "$BUMP_REF" >&2
  rm -rf "$tmp"
  exit 1
fi

# The extracted top-level dir is named after the ref (e.g. bumpstart-main), and
# that name varies, so glob for it rather than hard-code.
root=""
for d in "$tmp"/*/; do root="$d"; break; done

if [ -z "$root" ] || [ ! -f "${root}lib/apply.sh" ]; then
  printf 'bumpstart: unexpected tarball layout under %s\n' "$tmp" >&2
  rm -rf "$tmp"
  exit 1
fi

# exec replaces this process, so the tmpdir persists for the applier to use.
exec bash "${root}lib/apply.sh" "$@"
