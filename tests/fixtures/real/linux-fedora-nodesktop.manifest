# fedora:42 — no apt-get, so claude-desktop legitimately warns and skips, and the
# run's own verdict is STILL a green "Setup complete." (its skip paths exit 0).
# That combination is the blind spot the unexpected-warning assertion closes.
# REGENERATED FROM A REAL RUN (tests/real/lanes/run.sh fedora-safer), never
# hand-edited: this is a golden produced by the probe under test.
manifest_version	2
lane	fedora-safer
adapter	container
guest	fedora:42
axis	base
mode	apply
run	1
blocks	claude-cli claude-desktop gh-auth git mise node pnpm safer-installs welcome concise ask-first verify secrets
precheck.curl	present
precheck.wget	present
precheck.git	present
precheck.gpg	present
precheck.brew	absent
precheck.nopasswd	present
precheck.bumpstart_marker	absent
precheck.shell.kind	bash
precheck.shell.lic.claude	0
precheck.shell.lic.codex	0
precheck.shell.lic.gh	0
precheck.shell.lic.git	1
precheck.shell.lic.node	0
precheck.shell.lic.pnpm	0
precheck.shell.lic.mise	0
precheck.shell.ic.claude	0
precheck.shell.ic.codex	0
precheck.shell.ic.gh	0
precheck.shell.ic.git	1
precheck.shell.ic.node	0
precheck.shell.ic.pnpm	0
precheck.shell.ic.mise	0
precheck.shell.lc.claude	0
precheck.shell.lc.codex	0
precheck.shell.lc.gh	0
precheck.shell.lc.git	1
precheck.shell.lc.node	0
precheck.shell.lc.pnpm	0
precheck.shell.lc.mise	0
os	linux
env.root	0
env.login_shell	bash
env.pkg.apt	0
env.pkg.dnf	1
env.pkg.pacman	0
env.pkg.zypper	0
env.userns.restricted	apparmor
transcript.exit	0
transcript.verdict	clean
warn.0001	the Claude desktop app only ships for Debian/Ubuntu so far — skipping it.
transcript.warn_count	1
info.0001	Installing mise (a version manager for your tools)...
info.0002	Claude Code (the terminal one) is installed and is what this setup launches.
info.0003	Not a terminal — skipping gh auth. Run 'gh auth login' later.
info.0004	Not signed into GitHub yet — sign in (gh auth login), then re-run to set your git name/email.
info.0005	Your agent instructions live in one file:
info.0006	Both Claude and Codex read it (linked from their own config).
info.0007	💡 Edit that file in plain language to steer every future session.
info.0008	Claude config already exists — leaving it; you may see a one-time trust prompt.
info.0009	Your first message to the agent is saved here:
info.0010	Run 'claude' in $HOME/git/first-project to start (you'll sign in on first launch).
info.0011	A starter message is saved in $HOME/git/first-project/first-message.txt — paste it in as your first message.
tool.claude.runs	1
tool.claude.version_raw	2.1.220 (Claude Code)
tool.codex.runs	0
tool.codex.version_raw	absent
tool.gh.runs	1
tool.gh.version_raw	gh version 2.96.0 (2026-07-02) https://github.com/cli/cli/releases/tag/v2.96.0
tool.git.runs	1
tool.git.version_raw	git version 2.54.0
tool.node.runs	1
tool.node.version_raw	v24.18.0
tool.pnpm.runs	1
tool.pnpm.version_raw	11.17.0
tool.mise.runs	1
tool.mise.version_raw	2026.7.15 linux-arm64 (2026-07-27)
