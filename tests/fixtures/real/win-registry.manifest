# A windows-2025 CI run. Persistence here is a REGISTRY value rather than an rc line,
# so the fresh-shell check reads the registry PATH instead, both scopes, kept apart.
#
# HAND-WRITTEN, not probe output - no Windows machine is reachable from the fast
# suite, so this states what the runner image documents: Git, Node and gh arrive on
# the MACHINE PATH, so bumpstart's SATISFIED_WIN cells find them and the INSTALL_WIN cells
# never run. Only claude is really under test here, and the baseline is what says so
# out loud instead of three vacuous passes. The first Windows CI run after this lands
# is what confirms it.
manifest_version	2
lane	windows-2025
adapter	runner
guest	windows-2025
os	win
axis	base
mode	apply
run	1
blocks	claude-cli claude-desktop github git node welcome concise ask-first verify secrets
env.root	0
precheck.bumpstart_marker	absent
precheck.shell.kind	registry
precheck.shell.regpath.user.claude	0
precheck.shell.regpath.machine.claude	0
precheck.shell.regpath.claude	0
precheck.shell.regpath.user.codex	0
precheck.shell.regpath.machine.codex	0
precheck.shell.regpath.codex	0
precheck.shell.regpath.user.gh	0
precheck.shell.regpath.machine.gh	1
precheck.shell.regpath.gh	1
precheck.shell.regpath.user.git	0
precheck.shell.regpath.machine.git	1
precheck.shell.regpath.git	1
precheck.shell.regpath.user.node	0
precheck.shell.regpath.machine.node	1
precheck.shell.regpath.node	1
precheck.shell.regpath.user.pnpm	0
precheck.shell.regpath.machine.pnpm	0
precheck.shell.regpath.pnpm	0
precheck.shell.regpath.user.mise	0
precheck.shell.regpath.machine.mise	0
precheck.shell.regpath.mise	0
precheck.regpath.user.raw	C:\Users\runneradmin\AppData\Local\Microsoft\WindowsApps
transcript.exit	0
transcript.verdict	clean
transcript.warn_count	0
tool.claude.runs	1
tool.claude.version_raw	2.1.0 (Claude Code)
tool.gh.runs	1
tool.gh.version_raw	gh version 2.66.1
tool.git.runs	1
tool.git.version_raw	git version 2.51.0.windows.1
tool.node.runs	1
tool.node.version_raw	v24.4.0
shell.regpath.user.claude	1
shell.regpath.machine.claude	0
shell.regpath.claude	1
shell.regpath.user.codex	0
shell.regpath.machine.codex	0
shell.regpath.codex	0
shell.regpath.user.gh	0
shell.regpath.machine.gh	1
shell.regpath.gh	1
shell.regpath.user.git	0
shell.regpath.machine.git	1
shell.regpath.git	1
shell.regpath.user.node	0
shell.regpath.machine.node	1
shell.regpath.node	1
shell.regpath.user.pnpm	0
shell.regpath.machine.pnpm	0
shell.regpath.pnpm	0
shell.regpath.user.mise	0
shell.regpath.machine.mise	0
shell.regpath.mise	0
rc.file	registry:HKCU\Environment\Path
rc.persists_path	1
rc.vendor_path_lines	0
app.claude	1
instructions.canonical	$HOME/.agents/AGENTS.md
instructions.canonical.nonempty	1
instructions.link.claude	import:$HOME/.agents/AGENTS.md
instructions.section.git	1
instructions.section.node	1
