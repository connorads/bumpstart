# bumpstart real-install state manifest — a clean ubuntu:24.04 base lane, run 1.
# REGENERATED FROM A REAL RUN (tests/real/lanes/run.sh ubuntu-base), never
# hand-edited: this file is a golden produced by the probe under test, so a value
# invented to make a case pass is a fiction the whole suite then rests on. The
# hand-written NEGATIVE cases in real_judge.bats are the real assertions.
#
# The line to read twice: `precheck.shell.lc.git 1`. git resolved in a fresh login
# shell BEFORE bumpstart ran, because `env -i bash -lc` substitutes a compiled-in default
# PATH containing /usr/bin. That is why the fresh-shell assertions are a delta.
manifest_version	2
lane	ubuntu-base
adapter	container
guest	ubuntu:24.04
axis	base
mode	apply
run	1
blocks	claude-cli claude-desktop gh-auth git mise node welcome concise ask-first verify secrets
precheck.curl	present
precheck.wget	present
precheck.git	present
precheck.gpg	present
precheck.brew	absent
precheck.nopasswd	present
precheck.bumpstart_marker	absent
precheck.shell.kind	bash
precheck.shell.lic.claude	0
precheck.shell.lic.codex	0
precheck.shell.lic.gh	0
precheck.shell.lic.git	1
precheck.shell.lic.node	0
precheck.shell.lic.pnpm	0
precheck.shell.lic.mise	0
precheck.shell.ic.claude	0
precheck.shell.ic.codex	0
precheck.shell.ic.gh	0
precheck.shell.ic.git	1
precheck.shell.ic.node	0
precheck.shell.ic.pnpm	0
precheck.shell.ic.mise	0
precheck.shell.lc.claude	0
precheck.shell.lc.codex	0
precheck.shell.lc.gh	0
precheck.shell.lc.git	1
precheck.shell.lc.node	0
precheck.shell.lc.pnpm	0
