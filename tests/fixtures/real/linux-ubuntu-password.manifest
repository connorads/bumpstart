# ubuntu:24.04 on the password-sudo,no-git axis: the only leg where sudo really asks
# for a password, so askpass.count is the assertion, and the only one where git is
# genuinely absent beforehand — which is what makes the privileged path run at all.
# REGENERATED FROM A REAL RUN (tests/real/lanes/run.sh ubuntu-password), never
# hand-edited: this is a golden produced by the probe under test.
manifest_version	2
lane	ubuntu-password
adapter	container
guest	ubuntu:24.04
axis	password-sudo,no-git
mode	apply
run	1
blocks	claude-cli github mise node git
precheck.curl	present
precheck.wget	present
precheck.git	absent
precheck.gpg	present
precheck.brew	absent
precheck.nopasswd	absent
precheck.bumpstart_marker	absent
precheck.shell.kind	bash
precheck.shell.lic.claude	0
precheck.shell.lic.codex	0
