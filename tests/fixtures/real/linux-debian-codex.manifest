# debian:12, codex starter. Non-root with apparmor_restrict_unprivileged_userns=1,
# so the sandbox warning is legitimate AND the printed fix must name that knob.
# REGENERATED FROM A REAL RUN (tests/real/lanes/run.sh debian-codex), never
# hand-edited: this is a golden produced by the probe under test.
manifest_version	2
lane	debian-codex
adapter	container
guest	debian:12
axis	base
mode	apply
run	1
blocks	codex-cli codex-desktop gh-auth git mise node welcome concise ask-first verify secrets
precheck.curl	present
precheck.wget	present
precheck.git	present
precheck.gpg	present
precheck.brew	absent
precheck.nopasswd	present
precheck.vibe_marker	absent
precheck.shell.kind	bash
precheck.shell.lic.claude	0
