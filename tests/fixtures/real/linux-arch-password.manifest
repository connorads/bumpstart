# archlinux:base, claude-cli node, on the password-sudo axis. The only leg where
# sudo really asks for a password, so askpass.count is the assertion.
manifest_version	1
lane	arch-password
adapter	container
guest	archlinux:base
os	linux
axis	password-sudo
mode	apply
run	1
blocks	claude-cli mise node
env.root	0
env.login_shell	bash
env.pkg.apt	0
env.pkg.dnf	0
env.pkg.pacman	1
env.userns.restricted	none
precheck.curl	present
precheck.git	present
precheck.gpg	present
precheck.nopasswd	absent
precheck.vibe_marker	absent
transcript.exit	0
transcript.verdict	clean
transcript.warn_count	0
tool.claude.runs	1
tool.claude.version_raw	2.1.0 (Claude Code)
tool.mise.runs	1
tool.mise.version_raw	2026.7.1 linux-arm64
tool.node.runs	1
tool.node.version_raw	v24.4.0
shell.kind	bash
shell.lic.claude	1
shell.lic.mise	1
shell.lic.node	1
shell.ic.claude	1
shell.ic.mise	1
shell.ic.node	1
shell.lc.claude	0
shell.lc.mise	0
shell.lc.node	0
rc.file	$HOME/.bashrc
rc.marker_count	1
rc.block	export PATH="$HOME/.local/bin:$HOME/.codex/bin:${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$PATH"
rc.vendor_path_lines	0
askpass.count	1
askpass.0001	[sudo] password for tester:
instructions.canonical	$HOME/.agents/AGENTS.md
instructions.canonical.nonempty	1
instructions.link.claude	symlink:$HOME/.agents/AGENTS.md
instructions.section.node	1
