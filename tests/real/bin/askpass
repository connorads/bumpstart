#!/bin/sh
# shellcheck shell=sh
# askpass: the SUDO_ASKPASS target for the password-sudo lane.
#
# It logs the prompt sudo passed as $1, one line per invocation, so the count is
# measurable, and then prints the password. What gets asserted is the actual promise
# ("asks once, and only if git needs installing"), not keystroke choreography — and
# an unstubbed prompt would otherwise be a six-hour hang.
#
# SUDO_ASKPASS alone does NOT reach here on sudo 1.9.15p5 despite what its man page
# says; see bin/sudo-forces-askpass, which is why -A gets added. The prompt count is
# ATTEMPTS, not distinct requests: a wrong password logs three lines, because sudo
# retries three times.
#
# Fails closed: no password file means exit non-zero, so sudo refuses rather than
# silently proceeding as if the password were empty.
#
# POSIX sh, not bash: it runs as sudo's helper on every distro in the matrix, and it
# needs nothing bash provides.

STATE="${BUMP_REAL_DIR:-/tmp/vibe-real}"

printf '%s\n' "${1:-<sudo gave no prompt>}" >> "$STATE/askpass.log" 2>/dev/null

if [ ! -f "$STATE/password" ]; then
  printf 'askpass: no password file at %s/password\n' "$STATE" >&2
  exit 1
fi

cat "$STATE/password"
